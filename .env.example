# 复制为项目根目录 `.env` 后再填写真实值。
# 应用启动时会自动读取该文件，适用于 IDE 直接跑 main 和 `mvn spring-boot:run`。
#
# 本地开发的基础设施分两套（不要混用）：
# - MySQL、Redis：Homebrew 本机服务（brew services start mysql/redis）
# - ES、Kafka、MinIO：Docker（docker compose -f docs/docker-compose.yaml up -d es kafka minio）
# 下方默认值与 docs/docker-compose.yaml 保持一致，直接可用；标注 change-me 的必须自行填写。

# Spring profile，通常本地使用 dev
SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=Asia/Shanghai

# 服务监听端口
SERVER_PORT=8081

# MySQL（Homebrew 本机），库名建议保持为 ragproject
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ragproject?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Redis（Homebrew 本机默认无密码；若改用 Docker redis 则密码见 docs/docker-compose.yaml）
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Kafka（Docker），topic 会在应用启动时自动创建，无需再手工执行 kafka-topics.sh
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SPRING_KAFKA_TOPIC_PARTITIONS=1
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1

# MinIO（Docker，端口 19000，凭据与 docs/docker-compose.yaml 一致）
# 注意：19000 是 Docker 版端口；infra.sh 原生方案是 9000，二选一别混用
MINIO_ENDPOINT=http://localhost:19000
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=ragproject2025
MINIO_BUCKET_NAME=uploads

# Elasticsearch（Docker，纯 http 未开 SSL，SCHEME 必须是 http）
# 仅在自建 https+自签名证书时才需要 SCHEME=https + TRUST_ALL=true
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=ragproject2025
ELASTICSEARCH_INSECURE_TRUST_ALL_CERTIFICATES=false

# JWT_SECRET_KEY 必须是 Base64 字符串，用 `openssl rand -base64 32` 生成，勿用示例值
JWT_SECRET_KEY=change-me

# 首次启动创建管理员时临时打开，创建成功后应改回 false
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

# 是否开放注册
APP_AUTH_REGISTRATION_ENABLED=true

# 前端来源白名单，多个域名用逗号分隔
SECURITY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# LLM 与 Embedding 提供方（也可在管理后台"模型提供商"页面配置，数据库配置优先于此处）
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=

# 日志等级，排障时可临时改为 DEBUG
LOG_LEVEL_APP=INFO

# 前端部署（不用可留空）
DEPLOY_SERVER_HOST=
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_KEY=/absolute/path/to/deploy-key.pem
DEPLOY_TARGET_DIR=/home/www/ragproject-Front
DEPLOY_HEALTHCHECK_URL=https://your-domain.example
DEPLOY_HEALTHCHECK_TIMEOUT=15

# 微信支付相关配置（不用保持 false 即可）
WX_PAY_ENABLE=false
WX_PAY_APP_ID=
WX_PAY_MERCHANT_ID=
WX_PAY_PRIVATE_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://your-domain.example/api/v1/recharge/pay-callback
WX_PAY_REFUND_NOTIFY_URL=https://your-domain.example/api/v1/recharge/refund-callback
