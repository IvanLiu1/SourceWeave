# Docker Compose 全栈部署配置
# 使用：cp .env.docker.example .env，填写所有密码/密钥后执行 docker compose up -d --build
# 注意：根目录 .env.example 是本地开发（IDE/mvn 直跑）用的，两者不要混用。

# ===== 必填：各服务密码（请全部替换为强密码）=====
MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
ELASTIC_PASSWORD=change-me
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me

# JWT 签名密钥，必须是 Base64 字符串，可用 `openssl rand -base64 32` 生成
JWT_SECRET_KEY=

# ===== 必填：AI 服务 =====
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# ===== 端口 =====
# 前端访问端口（浏览器访问 http://<服务器IP>:8080）
FRONTEND_PORT=8080
# 后端端口（仅绑定 127.0.0.1，供宿主机 nginx 直连后端时使用）
BACKEND_PORT=8081

# ===== 对外地址 =====
# MinIO 公网访问地址：浏览器预览/下载文件时使用，需替换为服务器实际可达地址
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_BUCKET_NAME=uploads
# 前端来源白名单（CORS），生产环境填写实际域名，多个用逗号分隔
SECURITY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== 首次启动：创建管理员（创建成功后改回 false 并重启）=====
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

# ===== 注册模式：OPEN / INVITE_ONLY / CLOSED =====
APP_AUTH_REGISTRATION_MODE=INVITE_ONLY
APP_AUTH_INVITE_REQUIRED=true

# ===== 可选：资源与日志 =====
# 后端 JVM 内存
JAVA_OPTS=-Xms512m -Xmx1g
# Elasticsearch JVM 内存与容器内存上限
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_MEMORY_LIMIT=2g
# 日志等级（排障时可临时改 DEBUG）
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO

# ===== 可选：DeepSeek / Embedding 自定义 =====
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_MODEL=deepseek-chat
# EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_MODEL=text-embedding-v4

# ===== 可选：微信支付 =====
WX_PAY_ENABLE=false
WX_PAY_APP_ID=
WX_PAY_MERCHANT_ID=
WX_PAY_PRIVATE_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=
WX_PAY_REFUND_NOTIFY_URL=
